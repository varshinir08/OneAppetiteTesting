<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OneAppetite Negative" verbose="1">
    <listeners>
        <listener class-name="com.cts.mfrp.oneappetite.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <!-- Filter: run only @Test methods whose groups array contains "negative".
         These are the edge-case / error-path / invalid-input tests across the suite. -->
    <groups>
        <run>
            <include name="negative"/>
        </run>
    </groups>

    <!-- Scan every test class under all sub-packages; TestNG applies the
         "negative" filter above so only the matching @Test methods run. -->
    <test name="OneAppetite Negative Suite">
        <packages>
            <package name="com.cts.mfrp.oneappetite.tests.auth"/>
            <package name="com.cts.mfrp.oneappetite.tests.shared"/>
            <package name="com.cts.mfrp.oneappetite.tests.vendor"/>
            <package name="com.cts.mfrp.oneappetite.tests.employee"/>
            <package name="com.cts.mfrp.oneappetite.tests.admin"/>
        </packages>
    </test>
</suite>
