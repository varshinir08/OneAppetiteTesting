<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OneAppetite Functional" verbose="1">
    <listeners>
        <listener class-name="com.cts.mfrp.oneappetite.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <!-- Filter: run only @Test methods whose groups array contains "functional".
         These tests assert on business rules, data formatting, validation logic,
         numeric / pattern checks, filter behaviour — anything that's about *behavior*
         rather than rendering. Useful after backend / validation logic changes. -->
    <groups>
        <run>
            <include name="functional"/>
        </run>
    </groups>

    <!-- Auto-discover every test class under all sub-packages. -->
    <test name="OneAppetite Functional Suite">
        <packages>
            <package name="com.cts.mfrp.oneappetite.tests.auth"/>
            <package name="com.cts.mfrp.oneappetite.tests.shared"/>
            <package name="com.cts.mfrp.oneappetite.tests.vendor"/>
            <package name="com.cts.mfrp.oneappetite.tests.employee"/>
            <package name="com.cts.mfrp.oneappetite.tests.admin"/>
        </packages>
    </test>
</suite>
