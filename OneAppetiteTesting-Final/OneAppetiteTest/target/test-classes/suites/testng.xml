<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OneAppetite Full Regression" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="com.cts.mfrp.oneappetite.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <test name="Authentication (2.1, 2.2, 2.3)">
        <classes>
            <class name="com.cts.mfrp.oneappetite.tests.auth.LoginTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.auth.ForgotPasswordTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.auth.CreateAccountTest"/>
        </classes>
    </test>

    <test name="Shared - Theming, Notifications and UI (2.4, 2.5)">
        <classes>
            <class name="com.cts.mfrp.oneappetite.tests.shared.ThemeTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.shared.NotificationsTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.shared.TopBarComponentTest"/>
        </classes>
    </test>

    <test name="Employee Flow (2.6 - 2.12)">
        <classes>
            <class name="com.cts.mfrp.oneappetite.tests.employee.LocationSelectionTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.employee.DashboardPageTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.employee.CartPageTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.employee.OrderPageTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.employee.MyOrdersTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.employee.EmployeeSettingsTest"/>
        </classes>
    </test>

    <test name="Vendor Flow (2.13 - 2.15)">
        <classes>
            <class name="com.cts.mfrp.oneappetite.tests.vendor.MenuPageTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.vendor.VendorDashboardTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.vendor.VendorMenuMgmtTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.vendor.VendorSettingsTest"/>
        </classes>
    </test>

    <test name="Admin Flow (2.16, 2.17)">
        <classes>
            <class name="com.cts.mfrp.oneappetite.tests.admin.AdminUserMgmtTest"/>
            <class name="com.cts.mfrp.oneappetite.tests.admin.AdminSettingsTest"/>
        </classes>
    </test>
</suite>
